{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "schedule:monthly"
  ],
  "ignorePresets": [":semanticPrefixFixDepsChoreOthers"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "separateMajorMinor": false,
  "packageRules": [
    {
      "groupName": "other dependencies",
      "description": "catchall for anything not specified",
      "matchPackageNames": ["*"]
    },
    {
      "groupName": "java dependencies",
      "matchCategories": ["java"]
    },
    {
      "groupName": "gradle",
      "matchManagers": ["gradle-wrapper"]
    },
    {
      "groupName": "ci/cd dependencies",
      "matchCategories": ["ci", "cd", "docker"]
    },
    {
      "groupName": "ci/cd dependencies",
      "matchManagers": ["custom.regex"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "versions in workflows tagged with a `# renovate:` comment",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: (?<currentValue>\\S+)"
      ]
    }
  ]
}
